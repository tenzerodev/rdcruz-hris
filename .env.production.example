# Production settings for the HRIS. Copy to .env on the server, then run: php artisan key:generate
# KEEP A COPY OF THE FINAL .env (especially APP_KEY) WITH YOUR BACKUPS — without it, encrypted
# data (government ID numbers, two-step secrets) in a backup cannot be read.

APP_NAME="HRIS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address people type. Must be HTTPS: cameras only work on secure pages, and QR codes on printouts use it.
APP_URL=https://hris.agency.gov.ph
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Email can also be set in the app: System status → Email (overrides these).
MAIL_MAILER=smtp
MAIL_HOST=smtp.agency.gov.ph
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hris@agency.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Face match strictness (lower = stricter). 0.45 suits most offices.
DTR_MATCH_THRESHOLD=0.45
